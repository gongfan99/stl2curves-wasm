# Assemble isolated variant artifacts; shared files come from this checkout once.
if(NOT DEFINED ROOT OR NOT DEFINED INPUT_DIR)
  message(FATAL_ERROR "ROOT and INPUT_DIR are required")
endif()
if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${ROOT}/dist")
endif()
file(GLOB existing "${OUTPUT_DIR}/*" "${OUTPUT_DIR}/.[!.]*")
if(existing)
  message(FATAL_ERROR "Assembly output directory must be empty: ${OUTPUT_DIR}")
endif()

foreach(variant threaded single_thread)
  set(source "${INPUT_DIR}/${variant}")
  set(destination "${OUTPUT_DIR}/${variant}")
  foreach(asset stl2curves.js stl2curves.wasm stl2curves.d.ts)
    if(NOT EXISTS "${source}/${asset}" OR IS_DIRECTORY "${source}/${asset}")
      message(FATAL_ERROR "Missing ${variant} build output: ${asset}")
    endif()
    file(SIZE "${source}/${asset}" asset_size)
    if(asset_size EQUAL 0)
      message(FATAL_ERROR "Empty ${variant} build output: ${asset}")
    endif()
    file(COPY "${source}/${asset}" DESTINATION "${destination}")
  endforeach()
  file(GLOB workers "${source}/*.worker.*")
  if(workers)
    file(COPY ${workers} DESTINATION "${destination}")
  endif()

  foreach(port opencascade eigen3 nanoflann libzip pugixml tinygltf nlohmann-json stb)
    if(NOT EXISTS "${source}/licenses/${port}/copyright")
      message(FATAL_ERROR "Missing ${variant} dependency notice: ${port}")
    endif()
  endforeach()
  file(GLOB notices "${source}/licenses/*/copyright")
  foreach(notice IN LISTS notices)
    get_filename_component(port_directory "${notice}" DIRECTORY)
    get_filename_component(port "${port_directory}" NAME)
    set(target "${OUTPUT_DIR}/licenses/${port}/copyright")
    file(SIZE "${notice}" notice_size)
    if(notice_size EQUAL 0)
      message(FATAL_ERROR "Empty ${variant} dependency notice: ${port}")
    endif()
    if(EXISTS "${target}")
      file(SHA256 "${notice}" source_hash)
      file(SHA256 "${target}" target_hash)
      if(NOT source_hash STREQUAL target_hash)
        message(FATAL_ERROR "Dependency notices differ between variants: ${port}")
      endif()
    else()
      file(MAKE_DIRECTORY "${OUTPUT_DIR}/licenses/${port}")
      file(COPY "${notice}" DESTINATION "${OUTPUT_DIR}/licenses/${port}")
    endif()
  endforeach()
endforeach()

file(SHA256 "${OUTPUT_DIR}/threaded/stl2curves.d.ts" threaded_types)
file(SHA256 "${OUTPUT_DIR}/single_thread/stl2curves.d.ts" single_thread_types)
if(NOT threaded_types STREQUAL single_thread_types)
  message(FATAL_ERROR "Type declarations differ between variants")
endif()
file(COPY "${ROOT}/wasm/loader.mjs" "${ROOT}/wasm/loader.d.mts" DESTINATION "${OUTPUT_DIR}")
file(COPY "${ROOT}/LICENSE" "${ROOT}/THIRD_PARTY_NOTICES.md" DESTINATION "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/package.json" "{\"type\":\"module\"}\n")
message(STATUS "Both variants and shared files assembled in ${OUTPUT_DIR}")
