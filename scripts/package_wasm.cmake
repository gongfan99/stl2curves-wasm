if(NOT VARIANT MATCHES "^(threaded|single_thread)$")
  message(FATAL_ERROR "Invalid variant")
endif()
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${ROOT}/build_wasm_${VARIANT}")
endif()
if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${ROOT}/dist")
endif()
set(source "${BUILD_DIR}")
set(destination "${OUTPUT_DIR}/${VARIANT}")
file(MAKE_DIRECTORY "${destination}")
foreach(asset stl2curves.js stl2curves.wasm stl2curves.d.ts)
  if(NOT EXISTS "${source}/${asset}")
    message(FATAL_ERROR "Missing build output: ${asset}")
  endif()
  file(COPY "${source}/${asset}" DESTINATION "${destination}")
endforeach()
file(GLOB workers "${source}/*.worker.*")
if(workers)
  file(COPY ${workers} DESTINATION "${destination}")
endif()
if(VARIANT_ONLY)
  # Build jobs upload this directory alone. Keep its dependency notices with it
  # until the assembly job can compare and deduplicate them.
  set(notice_destination "${destination}/licenses")
else()
  file(COPY "${ROOT}/wasm/loader.mjs" "${ROOT}/wasm/loader.d.mts" DESTINATION "${OUTPUT_DIR}")
  file(COPY "${ROOT}/LICENSE" "${ROOT}/THIRD_PARTY_NOTICES.md" DESTINATION "${OUTPUT_DIR}")
  file(WRITE "${OUTPUT_DIR}/package.json" "{\"type\":\"module\"}\n")
  set(notice_destination "${OUTPUT_DIR}/licenses")
endif()
string(REPLACE "_" "-" triplet_variant "${VARIANT}")
file(GLOB notices "${source}/vcpkg_installed/wasm32-emscripten-${triplet_variant}/share/*/copyright")
foreach(notice IN LISTS notices)
  get_filename_component(port_directory "${notice}" DIRECTORY)
  get_filename_component(port "${port_directory}" NAME)
  file(MAKE_DIRECTORY "${notice_destination}/${port}")
  file(COPY "${notice}" DESTINATION "${notice_destination}/${port}")
endforeach()
